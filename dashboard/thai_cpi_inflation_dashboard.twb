                  <formatted-text>
                    <run fontcolor='#496779' fontname='PingFang TC' fontsize='10'>    THAILAND · ECONOMIC RESEARCH · 2021–2026</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#18334b' fontname='PingFang TC' fontsize='18'>  Thai CPI Inflation: Decomposition and Forecast Evaluation</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#496779' fontname='PingFang TC' fontsize='12'>   An Empirical Analysis of Year-on-Year Inflation Dynamics, Monthly Price Changes, Base Effects and Predictive Model Performance</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#8b9598' fontname='PingFang TC' fontsize='10'>    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#8b9598' fontname='PingFang TC' fontsize='10'>    CONSUMER PRICE INDEX / INFLATION DYNAMICS / WALK-FORWARD EVALUATION</run>
                  </formatted-text>
