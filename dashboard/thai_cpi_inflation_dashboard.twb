                <zone forceUpdate='true' h='6333' id='45' type-v2='text' w='43436' x='1100' y='31917'>
                  <formatted-text>
                    <run bold='true' fontcolor='#496779' fontname='PingFang TC'>    SECTION 01 · INFLATION DYNAMICS</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#18334b' fontname='PingFang TC' fontsize='11'>   Decomposing Headline Inflation: Monthly Price Changes and Base Effects</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#496779' fontname='PingFang TC'>    How Monthly Price Changes and Base Effects Shape YoY Inflation</run>
